{
  "name": "lms-platform",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.config.ts --testPathPattern='*.integration.test.ts'",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "npx tsx src/seed.ts",
    "db:seed:dev": "npx tsx src/seed.ts",
    "db:seed:reset": "npx tsx src/seed.ts --reset",
    "setup:dev": "node -e \"console.log('=== LMS Platform Setup ===');console.log('1. Copy .dev.vars.example to .dev.vars');console.log('2. Fill in NEON_DATABASE_URL and BETTER_AUTH_SECRET');console.log('3. npm run db:migrate');console.log('4. npm run dev (backend)');console.log('5. cd frontend && npm run dev (frontend)');console.log('6. Open http://localhost:5173/internal/admin-setup')\"",
    "db:reset-dev": "npx tsx src/seed.ts --reset",
    "course:validate": "npx tsx src/cli/course-validator.ts",
    "course:import": "npx tsx src/cli/course-importer.ts",
    "check": "npm run build && cd frontend && npm run build",
    "deploy:staging": "npx wrangler deploy --env staging",
    "deploy:production": "echo '⚠️  Production deploy requires manual approval' && npx wrangler deploy --env production"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@aws-sdk/s3-request-presigner": "^3.1133.0",
    "@better-auth/drizzle-adapter": "^1.2.0",
    "@neondatabase/serverless": "^0.10.0",
    "better-auth": "^1.2.0",
    "better-auth-cloudflare": "^0.1.0",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.7.0",
    "resend": "^6.28.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@eslint/js": "^9.0.0",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.107.1"
  }
}
