# =============================================================================
# LMS Platform — Environment Variables
# =============================================================================
# This file documents ALL environment variables used by the project.
# Backend variables go in .dev.vars (loaded by Wrangler).
# Frontend variables (VITE_*) go in frontend/.env
# =============================================================================

# ─── BACKEND (private — set in .dev.vars) ────────────────────────────────────

# Database (Neon PostgreSQL) — REQUIRED
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/lms_dev?sslmode=require

# Better Auth — REQUIRED
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:8787

# Admin Bootstrap — OPTIONAL (for first admin setup only)
ADMIN_BOOTSTRAP_SECRET=

# Email (Resend) — OPTIONAL (emails skipped if not set)
RESEND_API_KEY=

# R2 Storage (Cloudflare) — OPTIONAL (uploads fail gracefully if not set)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lms-dev

# App Configuration
ENVIRONMENT=development
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
